{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: node --watch server.js",
      "type": "shell",
      "command": "npm run dev",
      "options": { "env": { "APP_PORT": "9090" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "npm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "check (lint + test)",
      "type": "shell",
      "command": "npm run check",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "docker: build & up (local)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    }
  ]
}
